NODE_ENV=production
PORT=3000
DATABASE_URL=postgresql://gleisbau:change_me@db:5432/gleisbau
DATABASE_SSL=false
CORS_ORIGIN=https://app.example.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=info

# Bootstrap admin account (created/updated on every server start).
# No default — the server refuses to start without these. Use a real
# password (12+ chars), not a placeholder, in any environment reachable
# from the internet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_something_long_and_random
