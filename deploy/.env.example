# Domain and TLS
API_DOMAIN=api.example.com
APP_DOMAIN=app.example.com
ROOT_DOMAIN=example.com
CADDY_EMAIL=you@example.com

# Database
POSTGRES_USER=gleisbau
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gleisbau

# API
CORS_ORIGIN=https://app.example.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
API_PORT=3000

# Bootstrap admin account for the backend (see backend/.env.example)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_something_long_and_random

# Sitewide password gate for the frontend (Caddy basicauth).
# Generate the hash with: docker run --rm caddy:2 caddy hash-password --plaintext '<password>'
BASIC_AUTH_USER=change_me
BASIC_AUTH_HASH=change_me_bcrypt_hash
