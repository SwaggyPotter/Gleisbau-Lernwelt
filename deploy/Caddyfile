{
  email {$CADDY_EMAIL}
  servers {
    protocols h1 h2 h3
  }
}

# Nackte Domain (ohne Subdomain) leitet auf die App weiter, damit
# https://gleisbau-digital.org/ auch ohne "app."-Praefix funktioniert.
{$ROOT_DOMAIN} {
  redir https://{$APP_DOMAIN}{uri} permanent
}

# API (Express/Postgres-Backend) — kein Passwortschutz noetig, das Backend
# hat sein eigenes Login. Nur ueber HTTPS erreichbar, Rate-Limiting greift
# serverseitig im Node-Prozess.
{$API_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }

  reverse_proxy api:3000 {
    flush_interval -1
  }
}

# Frontend (Angular/Ionic-App als statische Dateien). Seit 2026-10-02 KEIN Browser-Popup
# (HTTP-Basic-Auth) mehr: die App-Huelle (index.html, JS, CSS) ist oeffentlich, enthaelt
# aber keine Inhalte. Alle Daten unter /assets/ (Fragenkataloge, Bilder, Diagramme) werden
# nur ausgeliefert, wenn das Cookie glw_gate gesetzt ist -- das setzt die Login-Maske der
# App nach erfolgreicher Anmeldung (src/app/core/site-gate/site-gate.component.ts).
# Cookie-Wert = SHA-256(Passwort + ":glw-gate-cookie-v1"); bei Passwortaenderung hier
# mitziehen. Schriften und Icons bleiben offen, damit die Login-Maske selbst rendert.
{$APP_DOMAIN} {
  encode zstd gzip

  @daten {
    path /assets/*
    not path /assets/fonts/* /assets/icon/*
    not header Cookie *glw_gate=eca3dbf650628f397ba910a9382de9595488fe9996a4d1887fd36ca36493ad1c*
  }
  respond @daten "Bitte in der App anmelden." 401

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }

  root * /srv/frontend
  try_files {path} /index.html
  file_server
}
