{
  email {$CADDY_EMAIL}
  servers {
    protocols h1 h2 h3
  }
}

# Nackte Domain (ohne Subdomain) leitet auf die App weiter, damit
# https://gleisbau-digital.org/ auch ohne "app."-Praefix funktioniert.
{$ROOT_DOMAIN} {
  redir https://{$APP_DOMAIN}{uri} permanent
}

# API (Express/Postgres-Backend) — kein Passwortschutz noetig, das Backend
# hat sein eigenes Login. Nur ueber HTTPS erreichbar, Rate-Limiting greift
# serverseitig im Node-Prozess.
{$API_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }

  reverse_proxy api:3000 {
    flush_interval -1
  }
}

# Frontend (Angular/Ionic-App als statische Dateien) — der Login liegt in
# der App selbst (client-seitiges Gate, Passwort im localStorage gemerkt),
# nicht mehr in Caddy. Kein HTTP-Basic-Auth mehr, weil der native Browser-
# Auth-Dialog von einem Firmennetzwerk aus nicht funktioniert hat.
{$APP_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }

  root * /srv/frontend
  try_files {path} /index.html
  file_server
}
