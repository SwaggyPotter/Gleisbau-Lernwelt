{
  email {$CADDY_EMAIL}
  servers {
    protocols h1 h2 h3
  }
}

# Nackte Domain (ohne Subdomain) leitet auf die App weiter, damit
# https://gleisbau-digital.org/ auch ohne "app."-Praefix funktioniert.
{$ROOT_DOMAIN} {
  redir https://{$APP_DOMAIN}{uri} permanent
}

# API (Express/Postgres-Backend) — kein Passwortschutz noetig, das Backend
# hat sein eigenes Login. Nur ueber HTTPS erreichbar, Rate-Limiting greift
# serverseitig im Node-Prozess.
{$API_DOMAIN} {
  encode zstd gzip

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }

  reverse_proxy api:3000 {
    flush_interval -1
  }
}

# Frontend (Angular/Ionic-App als statische Dateien) — zusaetzlich zum
# client-seitigen App-Gate seit 2026-09-13 wieder HTTP-Basic-Auth auf
# Server-Ebene: Solange die Seite kein Impressum hat, darf sie nicht
# oeffentlich erreichbar sein. Das client-seitige Gate allein schuetzt NICHT
# die statischen Dateien selbst (JS-Bundles, JSON-Fragenkataloge etc. waren
# ueber direkte URLs immer unauthentifiziert abrufbar, curl-verifiziert) --
# Basic-Auth auf Caddy-Ebene blockt jede Anfrage inkl. Assets, bevor
# ueberhaupt etwas ausgeliefert wird. Nur die API bleibt ohne Basic-Auth
# (siehe deren Kommentar oben) -- Browser-fetch()-Aufrufe zu einem anderen
# Origin koennen keinen interaktiven Basic-Auth-Dialog ausloesen, das wuerde
# alle App->API-Aufrufe (Login, Registrierung, Stats-Sync) brechen.
# Bekannte Einschraenkung (Grund der frueheren Entfernung): der native
# Browser-Auth-Dialog hat in mindestens einem Firmennetzwerk nicht
# funktioniert -- falls das wieder auftritt, Tim Bescheid geben.
{$APP_DOMAIN} {
  encode zstd gzip

  basic_auth {
    gleisbau $2a$14$UyZaKScTk0gVkUI1h1D59u3BGp3tX1ztZi7hiFzi2um2PL9zMWZAS
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }

  root * /srv/frontend
  try_files {path} /index.html
  file_server
}
